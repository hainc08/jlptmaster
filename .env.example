# Environment variables template for JLPT Master
# Mandatory MariaDB connection URL
DATABASE_URL="mysql://jlpt_user:jlpt_pass@localhost:3306/jlpt_master?connection_limit=5"
TEST_DATABASE_URL="mysql://jlpt_user:jlpt_pass@localhost:3306/jlpt_master_test?connection_limit=5"

# NextAuth / Auth.js
AUTH_SECRET="jlpt_master_super_secret_session_key_32_chars_min"
NEXTAUTH_URL="http://localhost:3000"

# S3 Object Storage (Media assets)
S3_ENDPOINT=""
S3_BUCKET="jlpt-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
