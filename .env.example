# Environment variables template for JLPT Master
# Mandatory MariaDB connection URL
DATABASE_URL="mysql://jlpt_user:jlpt_pass@localhost:3306/jlpt_master?connection_limit=5"
TEST_DATABASE_URL="mysql://jlpt_user:jlpt_pass@localhost:3306/jlpt_master_test?connection_limit=5"

# NextAuth / Auth.js
# REQUIRED in production: random string >= 32 chars (e.g. `openssl rand -base64 48`).
# The value below is a public dev default and is rejected when NODE_ENV=production.
AUTH_SECRET="jlpt_master_super_secret_session_key_32_chars_min"

# Seed passwords (scrypt-hashed on first seed; existing real passwords are never overwritten)
# SEED_ADMIN_PASSWORD=""
# SEED_STUDENT_PASSWORD=""
# Local/CI ONLY: set to 1 to use the public demo passwords from prisma/demo-credentials.ts
# SEED_DEMO_PASSWORDS=1
NEXTAUTH_URL="http://localhost:3000"

# S3 Object Storage (Media assets)
S3_ENDPOINT=""
S3_BUCKET="jlpt-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
